+import android.media.tv.TvInputManager;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Small live widgets under the clock (config.xml home_widgets): the weather from the Weather add-on (this launcher has
+ * no internet, the add-on fetches and shares its last reading), the Bluetooth headphones playing now with their
+ * battery, and the devices on the HDMI ports. Nothing polls: each one is read when Home comes back and when the system
+ * says it changed (a content change, a Bluetooth broadcast, a TV input state callback). A widget with nothing to say
+ * is hidden.
+ */
+final class HomeWidgets {
+    private static final Uri WEATHER = Uri.parse("content://io.github.sumyabazar1.weather.widget/current");
+    /** Hidden in the SDK but sent by Android since 8.1 for headphones that report their battery (HFP or Apple's). */
+    private static final String BATTERY_CHANGED = "android.bluetooth.device.action.BATTERY_LEVEL_CHANGED";
+
+    private final Activity activity;
+    private final LinearLayout row;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final float density;
+    private final Typeface font;
+    private final View weather, headphones, sources;
+    private BluetoothA2dp a2dp;
+    private boolean started;
+    /** config.xml weather_phrases: the feels-like temperature and a phrase in rioplatense slang. */
+    private final boolean phrases;
+
+    private final ContentObserver weatherObserver = new ContentObserver(handler) {
+        @Override
+        public void onChange(boolean selfChange) {
+            refreshWeather();
+        }
+    };
+    private final BroadcastReceiver bluetoothReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            refreshHeadphones();
+        }
+    };
+    private final TvInputManager.TvInputCallback inputCallback = new TvInputManager.TvInputCallback() {
+        @Override
+        public void onInputStateChanged(@NonNull String inputId, int state) {
+            refreshSources();
+        }
+
+        @Override
+        public void onInputAdded(@NonNull String inputId) {
+            refreshSources();
+        }
+
+        @Override
+        public void onInputRemoved(@NonNull String inputId) {
+            refreshSources();
+        }
+    };
+
+    HomeWidgets(Activity activity, LinearLayout row) {
+        this.activity = activity;
+        this.row = row;
+        density = activity.getResources().getDisplayMetrics().density;
+        font = activity.getResources().getFont(R.font.inter_tight_medium);
+        phrases = activity.getResources().getBoolean(R.bool.weather_phrases);
+        weather = chip(R.drawable.ic_w_cloud);
+        headphones = chip(R.drawable.ic_w_headphones);
+        sources = chip(R.drawable.ic_w_tv);
+        row.setVisibility(View.VISIBLE);
+        connectA2dp();
+    }
+
+    private View chip(int icon) {
+        LinearLayout chip = new LinearLayout(activity);
+        chip.setOrientation(LinearLayout.HORIZONTAL);
+        chip.setGravity(Gravity.CENTER_VERTICAL);
+        chip.setBackgroundResource(R.drawable.widget_chip);
+        int h = dp(10), v = dp(4);
+        chip.setPadding(h, v, h + dp(2), v);
+        ImageView iv = new ImageView(activity);
+        iv.setImageResource(icon);
+        iv.setAlpha(0.9f);
+        chip.addView(iv, new LinearLayout.LayoutParams(dp(13), dp(13)));
+        TextView tv = new TextView(activity);
+        tv.setTextColor(0xF2FFFFFF);
+        tv.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
+        tv.setTypeface(font);
+        tv.setSingleLine(true);
+        tv.setIncludeFontPadding(false);
+        tv.setShadowLayer(4 * density, 0, 1 * density, 0x66000000);
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
+                LinearLayout.LayoutParams.WRAP_CONTENT, LinearLayout.LayoutParams.WRAP_CONTENT);
+        lp.setMarginStart(dp(6));
+        chip.addView(tv, lp);
+        chip.setVisibility(View.GONE);
+        LinearLayout.LayoutParams clp = new LinearLayout.LayoutParams(
+                LinearLayout.LayoutParams.WRAP_CONTENT, LinearLayout.LayoutParams.WRAP_CONTENT);
+        clp.setMarginEnd(dp(8));
+        row.addView(chip, clp);
+        return chip;
+    }
+
+    private int dp(float v) {
+        return Math.round(v * density);
+    }
+
+    private static void show(View chip, int icon, CharSequence text) {
+        LinearLayout c = (LinearLayout) chip;
+        if (icon != 0) ((ImageView) c.getChildAt(0)).setImageResource(icon);
+        ((TextView) c.getChildAt(1)).setText(text);
+        c.setVisibility(View.VISIBLE);
+    }
+
+    // ---- lifecycle (MainActivity onStart / onResume / onStop) -------------------------------------
+
+    void start() {
+        if (started) return;
+        started = true;
+        try {
+            activity.getContentResolver().registerContentObserver(WEATHER, false, weatherObserver);
+        } catch (SecurityException ignored) {
+            // the add-on is not installed or not visible
+        }
+        IntentFilter f = new IntentFilter();
+        f.addAction(BluetoothA2dp.ACTION_CONNECTION_STATE_CHANGED);
+        f.addAction(BluetoothAdapter.ACTION_STATE_CHANGED);
+        f.addAction(BATTERY_CHANGED);
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            activity.registerReceiver(bluetoothReceiver, f, Context.RECEIVER_EXPORTED);
+        } else {
+            activity.registerReceiver(bluetoothReceiver, f);
+        }
+        TvInputManager tim = (TvInputManager) activity.getSystemService(Context.TV_INPUT_SERVICE);
+        if (tim != null) tim.registerCallback(inputCallback, handler);
+    }
+
+    void refresh() {
+        refreshWeather();
+        refreshHeadphones();
+        refreshSources();
+    }
+
+    void stop() {
+        if (!started) return;
+        started = false;
+        activity.getContentResolver().unregisterContentObserver(weatherObserver);
+        activity.unregisterReceiver(bluetoothReceiver);
+        TvInputManager tim = (TvInputManager) activity.getSystemService(Context.TV_INPUT_SERVICE);
+        if (tim != null) tim.unregisterCallback(inputCallback);
+    }
+
+    void close() {
+        stop();
+        BluetoothAdapter adapter = adapter();
+        if (adapter != null && a2dp != null) adapter.closeProfileProxy(BluetoothProfile.A2DP, a2dp);
+        a2dp = null;
+    }
+
+    // ---- weather -----------------------------------------------------------------------------------
+
+    private void refreshWeather() {
+        try (Cursor c = activity.getContentResolver().query(WEATHER, null, null, null, null)) {
+            if (c == null || !c.moveToFirst()) {
+                weather.setVisibility(View.GONE);
+                return;
+            }
+            int temp = c.getInt(c.getColumnIndexOrThrow("temp"));
+            String sky = c.getString(c.getColumnIndexOrThrow("sky"));
+            int code = c.getInt(c.getColumnIndexOrThrow("code"));
+            boolean day = c.getInt(c.getColumnIndexOrThrow("day")) == 1;
+            int feelsCol = c.getColumnIndex("feels");
+            int feels = feelsCol >= 0 ? c.getInt(feelsCol) : temp;
+            boolean celsius = !"F".equals(c.getString(c.getColumnIndexOrThrow("unit")));
+            if (phrases) {
+                // The add-on's phrase comes from the list it downloads (github.com/hidetsumi/tele-plugins);
+                // without one yet, the built-in list.
+                int phraseCol = c.getColumnIndex("phrase");
+                String phrase = phraseCol >= 0 && !c.isNull(phraseCol) ? c.getString(phraseCol) : null;
+                if (phrase == null || phrase.isEmpty()) {
+                    int feelsC = celsius ? feels : Math.round((feels - 32) * 5 / 9f);
+                    phrase = WeatherPhrases.phrase(feelsC, code);
+                }
+                show(weather, weatherIcon(code, day), feels + "°  " + phrase);
+            } else {
+                show(weather, weatherIcon(code, day), temp + "°  " + sky);
+            }
+        } catch (RuntimeException e) {
+            weather.setVisibility(View.GONE);   // add-on missing, or an older one without the widget provider
+        }
+    }
+
+    private static int weatherIcon(int code, boolean day) {
+        if (code <= 1) return day ? R.drawable.ic_w_sun : R.drawable.ic_w_moon;
+        if ((code >= 71 && code <= 77) || code == 85 || code == 86) return R.drawable.ic_w_snow;
+        if (code >= 51) return R.drawable.ic_w_rain;
+        return R.drawable.ic_w_cloud;
+    }
+
+    // ---- headphones --------------------------------------------------------------------------------
+
+    private boolean canUseBluetooth() {
+        return Build.VERSION.SDK_INT < Build.VERSION_CODES.S
+                || activity.checkSelfPermission(Manifest.permission.BLUETOOTH_CONNECT) == PackageManager.PERMISSION_GRANTED;
+    }
+
+    private BluetoothAdapter adapter() {
+        BluetoothManager bm = activity.getSystemService(BluetoothManager.class);
+        return bm == null ? null : bm.getAdapter();
+    }
+
+    private void connectA2dp() {
+        BluetoothAdapter adapter = adapter();
+        if (adapter == null || !canUseBluetooth()) return;
+        adapter.getProfileProxy(activity, new BluetoothProfile.ServiceListener() {
+            @Override
+            public void onServiceConnected(int profile, BluetoothProfile proxy) {
+                a2dp = (BluetoothA2dp) proxy;
+                refreshHeadphones();
+            }
+
+            @Override
+            public void onServiceDisconnected(int profile) {
+                a2dp = null;
+                refreshHeadphones();
+            }
+        }, BluetoothProfile.A2DP);
+    }
+
+    @SuppressLint("MissingPermission")   // checked in canUseBluetooth()
+    private void refreshHeadphones() {
+        if (a2dp == null || !canUseBluetooth()) {
+            headphones.setVisibility(View.GONE);
+            return;
+        }
+        List<BluetoothDevice> devices;
+        try {
+            devices = a2dp.getConnectedDevices();
+        } catch (RuntimeException e) {
+            devices = new ArrayList<>();
+        }
+        if (devices.isEmpty()) {
+            headphones.setVisibility(View.GONE);
+            return;
+        }
+        BluetoothDevice d = devices.get(0);
+        String name = null;
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) name = d.getAlias();
+        if (name == null || name.isEmpty()) name = d.getName();
+        if (name == null || name.isEmpty()) name = d.getAddress();
+        int battery = battery(d);
+        show(headphones, 0, battery >= 0 ? name + "  " + battery + "%" : name);
+    }
+
+    /** The battery the headphones report, or -1. getBatteryLevel is hidden in the SDK but open to apps. */
+    private static int battery(BluetoothDevice d) {
+        try {
+            Object v = BluetoothDevice.class.getMethod("getBatteryLevel").invoke(d);
+            return v instanceof Integer ? (Integer) v : -1;
+        } catch (Exception e) {
+            return -1;
+        }
+    }
+
+    // ---- HDMI devices ------------------------------------------------------------------------------
+
+    /** The devices on the HDMI ports: the name a device gives itself over CEC, else the port's own name. */
+    private void refreshSources() {
+        TvInputManager tim = (TvInputManager) activity.getSystemService(Context.TV_INPUT_SERVICE);
+        if (tim == null) {
+            sources.setVisibility(View.GONE);
+            return;
+        }
+        List<TvInputInfo> inputs;
+        try {
+            inputs = tim.getTvInputList();
+        } catch (RuntimeException e) {
+            sources.setVisibility(View.GONE);
+            return;
+        }
+        Set<String> ids = new HashSet<>();
+        for (TvInputInfo i : inputs) ids.add(i.getId());
+        int ports = 0, connectedPorts = 0;
+        List<String> names = new ArrayList<>();
+        for (TvInputInfo port : inputs) {
+            if (!port.isPassthroughInput() || port.getType() != TvInputInfo.TYPE_HDMI) continue;
+            if (port.getParentId() != null && ids.contains(port.getParentId())) continue;
+            ports++;
+            if (tim.getInputState(port.getId()) != TvInputManager.INPUT_STATE_CONNECTED) continue;
+            connectedPorts++;
+            String label = null;
+            for (TvInputInfo dev : inputs) {
+                if (port.getId().equals(dev.getParentId()) && !dev.isHidden(activity)) {
+                    CharSequence l = dev.loadLabel(activity);
+                    if (l != null && l.length() > 0) label = l.toString();
+                    break;
+                }
+            }
+            if (label == null) {
+                CharSequence custom = port.loadCustomLabel(activity);
+                label = String.valueOf(custom != null && custom.length() > 0 ? custom : port.loadLabel(activity));
+            }
+            names.add(label);
+        }
+        // Some TVs report every port as connected whatever is plugged in: then the list says nothing.
+        if (names.isEmpty() || (ports > 1 && connectedPorts == ports)) {
+            sources.setVisibility(View.GONE);
+            return;
+        }
+        String text = names.get(0);
+        if (names.size() > 1) text += "  +" + (names.size() - 1);
+        show(sources, 0, text);
+    }
+}
