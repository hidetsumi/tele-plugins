diff --git a/launcher/app/src/main/java/com/gathin/tvhome/UiSounds.java b/launcher/app/src/main/java/com/gathin/tvhome/UiSounds.java
new file mode 100644
index 00000000..6a17b9e4
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/UiSounds.java
@@ -0,0 +1,64 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.media.AudioAttributes;
+import android.media.SoundPool;
+import android.os.SystemClock;
+import android.util.SparseBooleanArray;
+
+/**
+ * Interface sounds (config.xml, ui_sounds): res/raw/sound_startup with the boot splash, sound_move when the remote
+ * moves focus, sound_select on OK. Decoded once into a SoundPool, so a key plays without touching the disk.
+ */
+final class UiSounds {
+
+    /** A startup sound still loading when the splash shows plays only if it is ready this soon after. */
+    private static final long STARTUP_LATE_MS = 1_500L;
+
+    private final SoundPool pool;
+    private final int startup, move, select;
+    private final SparseBooleanArray loaded = new SparseBooleanArray();
+    private long startupWanted;
+
+    UiSounds(Context ctx) {
+        pool = new SoundPool.Builder()
+                .setMaxStreams(3)
+                // Media, not sonification: TCL keeps the system stream at 0 on the TV's speakers, and the sounds
+                // should follow the TV's volume like the rest of what it plays.
+                .setAudioAttributes(new AudioAttributes.Builder()
+                        .setUsage(AudioAttributes.USAGE_MEDIA)
+                        .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
+                        .build())
+                .build();
+        startup = pool.load(ctx, R.raw.sound_startup, 1);
+        move = pool.load(ctx, R.raw.sound_move, 1);
+        select = pool.load(ctx, R.raw.sound_select, 1);
+        // Load results arrive on this (main) thread's looper, so none can come before the listener is set.
+        pool.setOnLoadCompleteListener((p, id, status) -> {
+            if (status != 0) return;
+            loaded.put(id, true);
+            if (id == startup && SystemClock.elapsedRealtime() - startupWanted < STARTUP_LATE_MS) play(id);
+        });
+    }
+
+    void startup() {
+        if (loaded.get(startup)) play(startup);
+        else startupWanted = SystemClock.elapsedRealtime();
+    }
+
+    void move() {
+        play(move);
+    }
+
+    void select() {
+        play(select);
+    }
+
+    void release() {
+        pool.release();
+    }
+
+    private void play(int id) {
+        if (loaded.get(id)) pool.play(id, 1f, 1f, 1, 0, 1f);
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/WeatherPhrases.java b/launcher/app/src/main/java/com/gathin/tvhome/WeatherPhrases.java
new file mode 100644
index 00000000..daf47385
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/WeatherPhrases.java
@@ -0,0 +1,88 @@
+package com.gathin.tvhome;
+
+import java.util.Calendar;
+
+/**
+ * config.xml weather_phrases: the weather widget in rioplatense slang, by the feels-like temperature (or the rain or
+ * storm when there is one). One phrase per band and per hour, so it changes during the day but not on every return
+ * to Home.
+ */
+final class WeatherPhrases {
+    private WeatherPhrases() { }
+
+    private static final String[] STORM = {
+            "Se viene la tormenta, guardá todo",
+            "Truenos, desenchufá la tele",
+            "Diluvio universal, ni asomes",
+    };
+    private static final String[] RAIN = {
+            "Llueve, día de tortas fritas",
+            "Está para quedarse tirado",
+            "Agarrá el paraguas, no seas gil",
+            "Garúa, finito pero molesta",
+    };
+    private static final String[] SNOW = {
+            "¡Nieva, loco! Esto no es normal",
+            "Cayó nieve, sacá la foto",
+    };
+    private static final String[] INFERNO = {           // 35 and up
+            "Te derretís como helado en la vereda",
+            "Un infierno, hermano",
+            "Calor de locos, ni salgas",
+            "Hace un calor que mata",
+    };
+    private static final String[] HOT = {               // 30 to 34
+            "Hace un re lorca",
+            "Lorca total, prendé el aire",
+            "Pegajoso mal, ni te muevas",
+            "Calor heavy, birra urgente",
+    };
+    private static final String[] WARM = {             // 25 to 29
+            "Lindo calorcito, está para pileta",
+            "Remerita y a la calle",
+            "Está para una birra en la vereda",
+            "Calorcito rico, che",
+    };
+    private static final String[] NICE = {             // 19 to 24
+            "Está joya, ni frío ni calor",
+            "Clima de mate en la plaza",
+            "Un día bárbaro, ni te quejes",
+            "Ideal, aprovechá",
+    };
+    private static final String[] COOL = {             // 13 to 18
+            "Fresquito, llevate un buzo",
+            "Está para camperita liviana",
+            "Fresco pero se banca",
+            "Refresca, no te hagas el canchero",
+    };
+    private static final String[] COLD = {             // 7 to 12
+            "Hace frío, che",
+            "Está para guiso y frazada",
+            "Re fresco, abrigate bien",
+            "Frío de cuarta, mate caliente ya",
+    };
+    private static final String[] FREEZING = {         // 6 and below
+            "Un frío que te parte al medio",
+            "Pingüino total, abrigate",
+            "Frío de morirse, no salgas",
+            "Helado mal, sacá la estufa",
+    };
+
+    /** feels in °C; code is the WMO weather code. */
+    static String phrase(int feelsC, int code) {
+        String[] band;
+        if (code >= 95) band = STORM;
+        else if ((code >= 71 && code <= 77) || code == 85 || code == 86) band = SNOW;
+        else if (code >= 51) band = RAIN;
+        else if (feelsC >= 35) band = INFERNO;
+        else if (feelsC >= 30) band = HOT;
+        else if (feelsC >= 25) band = WARM;
+        else if (feelsC >= 19) band = NICE;
+        else if (feelsC >= 13) band = COOL;
+        else if (feelsC >= 7) band = COLD;
+        else band = FREEZING;
+        Calendar now = Calendar.getInstance();
+        int pick = now.get(Calendar.DAY_OF_YEAR) * 24 + now.get(Calendar.HOUR_OF_DAY);
+        return band[pick % band.length];
+    }
+}
