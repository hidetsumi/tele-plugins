diff --git a/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/Phrases.java b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/Phrases.java
new file mode 100644
index 00000000..aa1fc6cb
--- /dev/null
+++ b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/Phrases.java
@@ -0,0 +1,82 @@
+package io.github.sumyabazar1.weather;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.Calendar;
+
+/**
+ * The home screen widget's phrases ("30° Hace un re lorca"), kept in a public GitHub repository so new ones arrive
+ * without touching the TV. Downloaded with each weather refresh; the last good copy is kept, and when there has never
+ * been one the launcher uses its own built-in phrases.
+ */
+final class Phrases {
+    static final String URL_FRASES =
+            "https://raw.githubusercontent.com/hidetsumi/tele-plugins/main/frases/frases.json";
+    private static final int TIMEOUT_MS = 8_000;
+
+    private Phrases() { }
+
+    /** Downloads the list and keeps it when it parses. Never throws: a failed download keeps the last copy. */
+    static void refresh(Context c) {
+        try {
+            HttpURLConnection conn = (HttpURLConnection) new URL(URL_FRASES).openConnection();
+            conn.setConnectTimeout(TIMEOUT_MS);
+            conn.setReadTimeout(TIMEOUT_MS);
+            conn.setUseCaches(false);
+            try (InputStream in = conn.getInputStream()) {
+                ByteArrayOutputStream out = new ByteArrayOutputStream();
+                byte[] buf = new byte[8192];
+                for (int n; (n = in.read(buf)) != -1; ) {
+                    out.write(buf, 0, n);
+                    if (out.size() > 512 * 1024) return;   // not what we expect; keep the last copy
+                }
+                String json = new String(out.toByteArray(), StandardCharsets.UTF_8);
+                new JSONObject(json).getJSONObject("rangos");   // parses, or throws and keeps the old copy
+                WidgetData.prefs(c).edit().putString("frases", json).apply();
+            } finally {
+                conn.disconnect();
+            }
+        } catch (Exception ignored) {
+            // offline, GitHub down or a broken file: the last copy stays
+        }
+    }
+
+    /** The range a reading falls in, by the same rules as the launcher's built-in phrases. */
+    static String range(int feelsC, int code) {
+        if (code >= 95) return "Tormenta";
+        if ((code >= 71 && code <= 77) || code == 85 || code == 86) return "Nieve";
+        if (code >= 51) return "Lluvia";
+        if (feelsC >= 35) return "35° o más";
+        if (feelsC >= 30) return "30° a 34°";
+        if (feelsC >= 25) return "25° a 29°";
+        if (feelsC >= 19) return "19° a 24°";
+        if (feelsC >= 13) return "13° a 18°";
+        if (feelsC >= 7) return "7° a 12°";
+        return "6° o menos";
+    }
+
+    /** One phrase from the downloaded list for this reading, the same one for the whole hour; null when none. */
+    static String pick(SharedPreferences widget, int feelsC, int code) {
+        String json = widget.getString("frases", null);
+        if (json == null) return null;
+        try {
+            JSONArray list = new JSONObject(json).getJSONObject("rangos").optJSONArray(range(feelsC, code));
+            if (list == null || list.length() == 0) return null;
+            Calendar now = Calendar.getInstance();
+            int at = (now.get(Calendar.DAY_OF_YEAR) * 24 + now.get(Calendar.HOUR_OF_DAY)) % list.length();
+            String text = list.getJSONObject(at).optString("texto", "").trim();
+            return text.isEmpty() ? null : text;
+        } catch (Exception e) {
+            return null;
+        }
+    }
+}
