+++ b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/WidgetData.java
@@ -0,0 +1,105 @@
+package io.github.sumyabazar1.weather;
+
+import android.app.job.JobInfo;
+import android.app.job.JobScheduler;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.net.Uri;
+
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * The last reading, kept for the home screen's weather widget: the launcher has no internet permission, so this app
+ * fetches and the launcher only reads what is stored here through {@link WidgetProvider}.
+ */
+final class WidgetData {
+    static final String AUTHORITY = "io.github.sumyabazar1.weather.widget";
+    static final Uri URI = Uri.parse("content://" + AUTHORITY + "/current");
+    private static final String PREFS = "widget";
+    private static final int JOB_PERIODIC = 1, JOB_NOW = 2;
+
+    private WidgetData() { }
+
+    static SharedPreferences prefs(Context c) {
+        return c.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    /** Stores a fresh reading and tells the launcher. */
+    static void save(Context c, Forecast.Report r) {
+        prefs(c).edit()
+                .putLong("tempC", Double.doubleToRawLongBits(r.tempC))
+                .putLong("feelsC", Double.doubleToRawLongBits(r.feelsC))
+                .putInt("code", r.code)
+                .putBoolean("day", r.day)
+                .putLong("updated", System.currentTimeMillis())
+                .apply();
+        c.getContentResolver().notifyChange(URI, null);
+    }
+
+    /**
+     * How old a reading may be when Home asks for it before it is fetched again. Open-Meteo's "current" values change
+     * every 15 minutes, so fetching more often returns the same data.
+     */
+    static final long FRESH_MS = 15 * 60_000L;
+    private static final AtomicBoolean fetching = new AtomicBoolean();
+
+    static boolean stale(Context c) {
+        return System.currentTimeMillis() - prefs(c).getLong("updated", 0) > FRESH_MS;
+    }
+
+    /**
+     * Fetches now, on a thread of this process, when the reading is older than {@link #FRESH_MS}: the launcher queries
+     * the provider every time Home comes back, and its content observer redraws the widget when {@link #save} lands.
+     * One fetch at a time; the 30-minute job stays as the background refresh.
+     */
+    static void refreshIfStale(Context c) {
+        if (!stale(c) || !fetching.compareAndSet(false, true)) return;
+        Context app = c.getApplicationContext();
+        SharedPreferences place = app.getSharedPreferences("place", Context.MODE_PRIVATE);
+        if (!place.contains("name")) {
+            fetching.set(false);
+            return;
+        }
+        double lat = Double.longBitsToDouble(place.getLong("lat", 0));
+        double lon = Double.longBitsToDouble(place.getLong("lon", 0));
+        new Thread(() -> {
+            try {
+                Phrases.refresh(app);
+                save(app, Forecast.fetch(lat, lon, Forecast.MIN_DAYS));
+            } catch (Exception e) {
+                refreshSoon(app);   // offline or the service failed: the job retries once the network is back
+            } finally {
+                fetching.set(false);
+            }
+        }, "weather-on-home").start();
+    }
+
+    /** A refresh every 30 minutes while the network is up, kept across reboots. */
+    static void schedule(Context c) {
+        try {
+            JobScheduler js = c.getSystemService(JobScheduler.class);
+            if (js == null || js.getPendingJob(JOB_PERIODIC) != null) return;
+            js.schedule(new JobInfo.Builder(JOB_PERIODIC, new ComponentName(c, RefreshJob.class))
+                    .setPeriodic(Forecast.REFRESH_MS)
+                    .setRequiredNetworkType(JobInfo.NETWORK_TYPE_ANY)
+                    .setPersisted(true)
+                    .build());
+        } catch (RuntimeException ignored) {
+            // the widget stays on its last reading; the page itself still works
+        }
+    }
+
+    /** One refresh as soon as the network allows, when the stored reading is old. */
+    static void refreshSoon(Context c) {
+        try {
+            JobScheduler js = c.getSystemService(JobScheduler.class);
+            if (js == null || js.getPendingJob(JOB_NOW) != null) return;
+            js.schedule(new JobInfo.Builder(JOB_NOW, new ComponentName(c, RefreshJob.class))
+                    .setRequiredNetworkType(JobInfo.NETWORK_TYPE_ANY)
+                    .build());
+        } catch (RuntimeException ignored) {
+            // as above
+        }
+    }
+}
diff --git a/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/WidgetProvider.java b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/WidgetProvider.java
