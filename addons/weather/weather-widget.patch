diff --git a/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/Hourly.java b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/Hourly.java
new file mode 100644
index 00000000..1d6797d1
--- /dev/null
+++ b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/Hourly.java
@@ -0,0 +1,136 @@
+package io.github.sumyabazar1.weather;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.time.LocalDateTime;
+import java.time.ZoneId;
+import java.time.format.DateTimeFormatter;
+import java.util.Locale;
+
+/**
+ * The hourly forecast for the launcher's day card: the next hours, today's low and high, and when it next rains.
+ * Fetched with each widget refresh (Open-Meteo, ICON model, 7 days) and kept as the raw reply; the summary is worked
+ * out when the launcher asks, so "now" is always the current hour.
+ */
+final class Hourly {
+    private static final int TIMEOUT_MS = 8_000;
+    private static final int DAYS = 7;
+    /** Hours of the card: now, then every SLOT_STEP hours. */
+    private static final int SLOTS = 7, SLOT_STEP = 3;
+
+    private Hourly() { }
+
+    /** Downloads and keeps the forecast. Never throws: a failed download keeps the last copy. */
+    static void refresh(Context c, double lat, double lon) {
+        String url = String.format(Locale.ROOT, "https://api.open-meteo.com/v1/forecast?latitude=%.4f&longitude=%.4f"
+                + "&models=icon_seamless&hourly=temperature_2m,apparent_temperature,precipitation_probability,"
+                + "precipitation,weather_code,is_day&forecast_days=%d&timezone=auto", lat, lon, DAYS);
+        try {
+            HttpURLConnection conn = (HttpURLConnection) new URL(url).openConnection();
+            conn.setConnectTimeout(TIMEOUT_MS);
+            conn.setReadTimeout(TIMEOUT_MS);
+            try (InputStream in = conn.getInputStream()) {
+                ByteArrayOutputStream out = new ByteArrayOutputStream();
+                byte[] buf = new byte[8192];
+                for (int n; (n = in.read(buf)) != -1; ) out.write(buf, 0, n);
+                String json = new String(out.toByteArray(), StandardCharsets.UTF_8);
+                JSONObject root = new JSONObject(json);
+                root.getJSONObject("hourly").getJSONArray("time");
+                WidgetData.prefs(c).edit().putString("hourly", root.getJSONObject("hourly").toString())
+                        .putString("hourly_zone", root.optString("timezone", "UTC")).apply();
+            } finally {
+                conn.disconnect();
+            }
+        } catch (Exception ignored) {
+            // offline or the service is down: the last copy stays
+        }
+    }
+
+    private static boolean rains(int code, double mm) {
+        return code >= 51 || mm >= 0.2;
+    }
+
+    /**
+     * The card's data as JSON: {"low","high","hours":[{"time","temp","feels","code","day","pop","phrase"}],
+     * "nextRain":{"time","pop","mm"} or null, "horizonDays"}. Temperatures in the owner's unit. Null when there is no
+     * forecast yet.
+     */
+    static String summary(SharedPreferences widget, boolean fahrenheit) {
+        String raw = widget.getString("hourly", null);
+        if (raw == null) return null;
+        try {
+            JSONObject h = new JSONObject(raw);
+            JSONArray time = h.getJSONArray("time"), temp = h.getJSONArray("temperature_2m"),
+                    feels = h.getJSONArray("apparent_temperature"), pop = h.getJSONArray("precipitation_probability"),
+                    mm = h.getJSONArray("precipitation"), code = h.getJSONArray("weather_code"),
+                    day = h.getJSONArray("is_day");
+            ZoneId zone = ZoneId.of(widget.getString("hourly_zone", "UTC"));
+            String now = LocalDateTime.now(zone).format(DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH':00'"));
+            int start = -1;
+            for (int i = 0; i < time.length(); i++) {
+                if (time.getString(i).compareTo(now) >= 0) {
+                    start = i;
+                    break;
+                }
+            }
+            if (start < 0) return null;
+
+            String today = now.substring(0, 10);
+            double low = Double.MAX_VALUE, high = -Double.MAX_VALUE;
+            for (int i = 0; i < time.length(); i++) {
+                if (!time.getString(i).startsWith(today)) continue;
+                low = Math.min(low, temp.getDouble(i));
+                high = Math.max(high, temp.getDouble(i));
+            }
+
+            JSONArray hours = new JSONArray();
+            for (int s = 0; s < SLOTS; s++) {
+                int i = start + s * SLOT_STEP;
+                if (i >= time.length()) break;
+                int f = Forecast.degrees(feels.getDouble(i), false);
+                int wc = code.getInt(i);
+                hours.put(new JSONObject()
+                        .put("time", time.getString(i))
+                        .put("temp", Forecast.degrees(temp.getDouble(i), fahrenheit))
+                        .put("feels", Forecast.degrees(feels.getDouble(i), fahrenheit))
+                        .put("code", wc)
+                        .put("day", day.optInt(i, 1) == 1)
+                        .put("pop", pop.optInt(i, 0))
+                        .put("phrase", Phrases.pickAt(widget, f, wc, time.getString(i))));
+            }
+
+            JSONObject nextRain = null;
+            for (int i = start; i < time.length(); i++) {
+                if (!rains(code.getInt(i), mm.optDouble(i, 0))) continue;
+                double total = 0;
+                int maxPop = 0;
+                for (int j = i; j < time.length() && rains(code.getInt(j), mm.optDouble(j, 0)); j++) {
+                    total += mm.optDouble(j, 0);
+                    maxPop = Math.max(maxPop, pop.optInt(j, 0));
+                }
+                nextRain = new JSONObject().put("time", time.getString(i)).put("pop", maxPop)
+                        .put("mm", Math.round(total * 10) / 10.0);
+                break;
+            }
+
+            JSONObject out = new JSONObject()
+                    .put("low", Forecast.degrees(low, fahrenheit))
+                    .put("high", Forecast.degrees(high, fahrenheit))
+                    .put("hours", hours)
+                    .put("horizonDays", DAYS);
+            out.put("nextRain", nextRain == null ? JSONObject.NULL : nextRain);
+            return out.toString();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+}
