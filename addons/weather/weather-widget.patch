+package io.github.sumyabazar1.weather;
+
+import android.app.job.JobParameters;
+import android.app.job.JobService;
+import android.content.SharedPreferences;
+
+/** Fetches the weather now for the home screen widget; the forecast days are not needed for it. */
+public final class RefreshJob extends JobService {
+    private volatile Thread worker;
+
+    @Override
+    public boolean onStartJob(JobParameters params) {
+        SharedPreferences place = getSharedPreferences("place", MODE_PRIVATE);
+        if (!place.contains("name")) return false;
+        double lat = Double.longBitsToDouble(place.getLong("lat", 0));
+        double lon = Double.longBitsToDouble(place.getLong("lon", 0));
+        worker = new Thread(() -> {
+            boolean ok = false;
+            Phrases.refresh(this);
+            Hourly.refresh(this, lat, lon);
+            try {
+                WidgetData.save(this, Forecast.fetch(lat, lon, Forecast.MIN_DAYS));
+                ok = true;
+            } catch (Exception ignored) {
+                // offline or the service is down: try again later
+            }
+            jobFinished(params, !ok);
+        }, "weather-widget");
+        worker.start();
+        return true;
+    }
+
+    @Override
+    public boolean onStopJob(JobParameters params) {
+        Thread t = worker;
+        if (t != null) t.interrupt();
+        return true;
+    }
+}
