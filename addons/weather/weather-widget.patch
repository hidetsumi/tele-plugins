new file mode 100644
index 00000000..ca6064aa
--- /dev/null
+++ b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/Phrases.java
@@ -0,0 +1,133 @@
+package io.github.sumyabazar1.weather;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.Calendar;
+
+/**
+ * The home screen widget's phrases ("30° Hace un re lorca"), kept in a public GitHub repository so new ones arrive
+ * without touching the TV (github.com/hidetsumi/tele-plugins, phrases/phrases.json, schema version 2). Each category
+ * carries its own condition: a feels-like range in °C, or a weather type with a priority. Downloaded with each weather
+ * refresh; the last good copy is kept, and when there has never been one the launcher uses its built-in phrases.
+ */
+final class Phrases {
+    static final String URL_PHRASES =
+            "https://raw.githubusercontent.com/hidetsumi/tele-plugins/main/phrases/phrases.json";
+    private static final int SCHEMA_VERSION = 2;
+    private static final int TIMEOUT_MS = 8_000;
+    private static final String PREF = "phrases_v2";
+
+    private Phrases() { }
+
+    /** Downloads the list and keeps it when it is a version this code reads. A failed download keeps the last copy. */
+    static void refresh(Context c) {
+        try {
+            HttpURLConnection conn = (HttpURLConnection) new URL(URL_PHRASES).openConnection();
+            conn.setConnectTimeout(TIMEOUT_MS);
+            conn.setReadTimeout(TIMEOUT_MS);
+            conn.setUseCaches(false);
+            try (InputStream in = conn.getInputStream()) {
+                ByteArrayOutputStream out = new ByteArrayOutputStream();
+                byte[] buf = new byte[8192];
+                for (int n; (n = in.read(buf)) != -1; ) {
+                    out.write(buf, 0, n);
+                    if (out.size() > 512 * 1024) return;   // not what we expect; keep the last copy
+                }
+                String json = new String(out.toByteArray(), StandardCharsets.UTF_8);
+                JSONObject root = new JSONObject(json);
+                if (root.optInt("schemaVersion") != SCHEMA_VERSION) return;
+                root.getJSONArray("categories");
+                WidgetData.prefs(c).edit().putString(PREF, json).apply();
+            } finally {
+                conn.disconnect();
+            }
+        } catch (Exception ignored) {
+            // offline, GitHub down or a broken file: the last copy stays
+        }
+    }
+
+    /** The weather type of a WMO code, as the file names it; null for none (clear or cloudy). */
+    static String weatherType(int code) {
+        if (code >= 95) return "thunderstorm";
+        if ((code >= 71 && code <= 77) || code == 85 || code == 86) return "snow";
+        if (code >= 51) return "rain";
+        return null;
+    }
+
+    /**
+     * The category for a reading: the highest-priority category whose weather matches, else the first whose
+     * feels-like range holds the temperature. Null when none does.
+     */
+    static JSONObject category(JSONArray categories, int feelsC, int code) {
+        String weather = weatherType(code);
+        JSONObject best = null;
+        int bestPriority = Integer.MIN_VALUE;
+        if (weather != null) {
+            for (int i = 0; i < categories.length(); i++) {
+                JSONObject c = categories.optJSONObject(i);
+                if (c == null) continue;
+                JSONObject cond = c.optJSONObject("condition");
+                if (cond == null || !weather.equals(cond.optString("weather"))) continue;
+                int priority = c.optInt("priority", 0);
+                if (priority > bestPriority) {
+                    best = c;
+                    bestPriority = priority;
+                }
+            }
+            if (best != null) return best;
+        }
+        for (int i = 0; i < categories.length(); i++) {
+            JSONObject c = categories.optJSONObject(i);
+            if (c == null) continue;
+            JSONObject cond = c.optJSONObject("condition");
+            if (cond == null || cond.has("weather")) continue;
+            if (cond.has("feelsLikeMin") && feelsC < cond.optInt("feelsLikeMin")) continue;
+            if (cond.has("feelsLikeMax") && feelsC > cond.optInt("feelsLikeMax")) continue;
+            return c;
+        }
+        return null;
+    }
+
+    /** One phrase from the downloaded list for this reading, the same one for the whole hour; null when none. */
+    static String pick(SharedPreferences widget, int feelsC, int code) {
+        Calendar now = Calendar.getInstance();
+        return pick(widget, feelsC, code, now.get(Calendar.DAY_OF_YEAR) * 24 + now.get(Calendar.HOUR_OF_DAY));
+    }
+
+    /**
+     * The phrase for a forecast hour ("2026-11-23T21:00"), chosen the same way as for "now" so an hour keeps its
+     * phrase; "" when there is none.
+     */
+    static String pickAt(SharedPreferences widget, int feelsC, int code, String isoHour) {
+        try {
+            java.time.LocalDateTime t = java.time.LocalDateTime.parse(isoHour);
+            String p = pick(widget, feelsC, code, t.getDayOfYear() * 24 + t.getHour());
+            return p == null ? "" : p;
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    private static String pick(SharedPreferences widget, int feelsC, int code, int slot) {
+        String json = widget.getString(PREF, null);
+        if (json == null) return null;
+        try {
+            JSONObject c = category(new JSONObject(json).getJSONArray("categories"), feelsC, code);
+            JSONArray list = c == null ? null : c.optJSONArray("phrases");
+            if (list == null || list.length() == 0) return null;
+            String text = list.getJSONObject(Math.floorMod(slot, list.length())).optString("text", "").trim();
+            return text.isEmpty() ? null : text;
+        } catch (Exception e) {
+            return null;
+        }
+    }
+}
