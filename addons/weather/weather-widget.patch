+package io.github.sumyabazar1.weather;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.database.Cursor;
+import android.database.MatrixCursor;
+import android.net.Uri;
+
+/**
+ * Read-only: the stored reading for the launcher's home screen widget, in the unit and language the owner chose here.
+ * Columns: temp (whole degrees), unit ("C" or "F"), sky (words), code (WMO), day (1 or 0), place, updated (ms),
+ * feels (whole degrees, the feels-like temperature), phrase (from the downloaded list in {@link Phrases}, or null).
+ * Empty while no city is chosen or nothing has been fetched yet.
+ */
+public final class WidgetProvider extends ContentProvider {
+    private static final String[] COLUMNS = {"temp", "unit", "sky", "code", "day", "place", "updated", "feels", "phrase"};
+
+    @Override
+    public boolean onCreate() {
+        return true;
+    }
+
+    @Override
+    public Cursor query(Uri uri, String[] projection, String selection, String[] args, String sort) {
+        Context c = getContext();
+        MatrixCursor cursor = new MatrixCursor(COLUMNS, 1);
+        if (c == null) return cursor;
+        WidgetData.schedule(c);
+        SharedPreferences place = c.getSharedPreferences("place", Context.MODE_PRIVATE);
+        if (!place.contains("name")) return cursor;
+        WidgetData.refreshIfStale(c);
+        SharedPreferences w = WidgetData.prefs(c);
+        if (!w.contains("updated")) return cursor;
+        boolean f = c.getSharedPreferences("options", Context.MODE_PRIVATE).getBoolean("fahrenheit",
+                "f".equalsIgnoreCase(c.getString(R.string.temperature_unit).trim()));
+        double tempC = Double.longBitsToDouble(w.getLong("tempC", 0));
+        int code = w.getInt("code", 3);
+        boolean day = w.getBoolean("day", true);
+        double feelsC = Double.longBitsToDouble(w.getLong("feelsC", w.getLong("tempC", 0)));
+        cursor.addRow(new Object[]{Forecast.degrees(tempC, f), f ? "F" : "C", c.getString(Forecast.sky(code, day)),
+                code, day ? 1 : 0, place.getString("name", ""), w.getLong("updated", 0),
+                Forecast.degrees(feelsC, f), Phrases.pick(w, (int) Math.round(feelsC), code)});
+        cursor.setNotificationUri(c.getContentResolver(), WidgetData.URI);
+        return cursor;
+    }
+
+    @Override
+    public String getType(Uri uri) {
+        return "vnd.android.cursor.item/vnd.weather.current";
+    }
+
+    @Override
+    public Uri insert(Uri uri, ContentValues values) {
+        throw new UnsupportedOperationException();
+    }
+
+    @Override
+    public int delete(Uri uri, String selection, String[] args) {
+        throw new UnsupportedOperationException();
+    }
+
+    @Override
+    public int update(Uri uri, ContentValues values, String selection, String[] args) {
+        throw new UnsupportedOperationException();
+    }
+}
